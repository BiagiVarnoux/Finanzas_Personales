# Connection string de Neon (Postgres). Usá la versión "pooled".
# Ejemplo: postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Contraseña / PIN para entrar a la app
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
